---
import ProjectGallery from "./ProjectGallery.astro";

const projects = [
  {
    title: "Монтаж теплого пола",
    location: "г. Батуми, Грузия",
    cover: "/assets/img/heating-project-03-01.jpg",
    alt: "Монтаж водяного теплого пола в Батуми",
    galleryLabel: "Посмотреть фото монтажа теплого пола",
    images: [
      "/assets/img/heating-project-03-01.jpg",
      "/assets/img/heating-project-03-02.jpg",
      "/assets/img/heating-project-03-03.jpg",
      "/assets/img/heating-project-03-04.jpg",
    ],
  },
  {
    title: "Монтаж газовых котлов",
    location: "г. Батуми, Грузия",
    cover: "/assets/img/heating-project-04-01.jpg",
    alt: "Монтаж газовых котлов в Батуми",
    galleryLabel: "Посмотреть фото монтажа газовых котлов",
    images: [
      "/assets/img/heating-project-04-01.jpg",
      "/assets/img/heating-project-04-02.jpg",
      "/assets/img/heating-project-04-03.jpg",
    ],
  },
];
----

<section class="projects">
  <div class="wrapper">
    <h2 class="projects__title">
      Наши объекты
    </h2>

    <div class="projects__slider">
      <button
        class="projects__arrow projects__arrow--prev"
        type="button"
        aria-label="Попередній об'єкт"
      >
        &#10094;
      </button>

      <div class="projects__viewport">
        <div class="projects__track">
          {
            projects.map((project) => (
              <article class="projects__card">
                <button
                  class="projects__open-gallery"
                  type="button"
                  aria-label={project.galleryLabel}
                >
                  <img
                    src={project.cover}
                    alt={project.alt}
                    class="projects__img"
                  />

                  <span class="projects__photo-count">
                    📷 {project.images.length} фото
                  </span>
                </button>

                <div class="projects__info">
                  <h3 class="projects__name">
                    {project.title}
                  </h3>

                  <p class="projects__text">
                    {project.location}
                  </p>
                </div>

                <div class="projects__gallery" hidden>
                  {
                    project.images.map((image) => (
                      <img
                        src={image}
                        alt={project.alt}
                      />
                    ))
                  }
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <button
        class="projects__arrow projects__arrow--next"
        type="button"
        aria-label="Наступний об'єкт"
      >
        &#10095;
      </button>
    </div>
  </div>
</section>

<ProjectGallery />