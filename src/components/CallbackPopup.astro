<div class="callback-popup-overlay">
  <div class="callback-popup">
    <div class="callback-popup__content">
      <button
        class="callback-popup__close"
        type="button"
        aria-label="Закрити форму"
      ></button>

      <h3 class="callback-popup__title">
        Залиште номер, на який вам зателефонувати
      </h3>

      <h5 class="callback-popup__comment">
        Ми перетелефонуємо вам якнайшвидше
      </h5>

      <form
        class="callback-form"
        id="callbackForm"
        method="post"
      >
        <input
          type="hidden"
          name="source"
          value="header-callback"
        />

        <input
          type="tel"
          id="callbackPhone"
          name="phone"
          class="callback-form__input"
          required
        />

        <input
          type="text"
          name="name"
          class="callback-form__input"
          minlength="2"
          maxlength="30"
          placeholder="Ваше ім'я"
          required
        />

        <button
          type="submit"
          class="callback-form__btn"
        >
          Передзвоніть мені
        </button>

        <p class="callback-form__message"></p>
      </form>
    </div>
  </div>
</div>