---
interface Props {
  source: string;
  lang?: "uk" | "ru";
  initialCountry?: string;
}

const {
  source,
  lang = "uk",
  initialCountry = "ua",
} = Astro.props;

const texts = {
  uk: {
    title: "Отримати консультацію",
    subtitle: "Залиште контактні дані і наші фахівці зв'яжуться з вами.",
    name: "Ваше ім'я",
    button: "Замовити дзвінок",
  },
  ru: {
    title: "Получить консультацию",
    subtitle: "Оставьте контактные данные, и наши специалисты свяжутся с вами.",
    name: "Ваше имя",
    button: "Заказать звонок",
  },
};

const text = texts[lang];
---

<section class="consultation">
  <div class="wrapper">
    <div class="consultation__content">
      <h2 class="consultation__title">{text.title}</h2>

      <p class="consultation__text">
        {text.subtitle}
      </p>

      <form
        class="consultation__form"
        data-initial-country={initialCountry}
      >
        <input
          type="hidden"
          name="source"
          value={source}
        />

        <input
          type="text"
          name="name"
          class="consultation__input"
          minlength="2"
          maxlength="30"
          placeholder={text.name}
          required
        />

        <input
          type="tel"
          id={`consultationPhone-${source}`}
          name="phone"
          class="consultation__input consultation__phone"
          required
        />

        <button
          type="submit"
          class="consultation__btn"
        >
          {text.button}
        </button>

        <p class="consultation__message"></p>
      </form>
    </div>
  </div>
</section>