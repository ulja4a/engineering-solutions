---

import ProjectGallery from "./ProjectGallery.astro";

const projects = [
  {
    title:
      "Сонячна електростанція на 50 кВт з системою зберігання енергії",
    location: "м. Харків",
    cover: "/assets/img/sunenergy-project-1.jpg",
    alt: "Сонячна електростанція",
    galleryLabel: "Переглянути фото сонячної електростанції",
    images: [
      "/assets/img/sunenergy-project-1.jpg",
    ],
  },
  {
    title: "Сонячна електростанція на 50 кВт",
    location: "Полтавська область",
    cover: "/assets/img/poltava_project-7.jpg",
    alt: "Сонячна електростанція на 50 кВт, Полтавська область",
    galleryLabel: "Переглянути фото сонячної електростанції",
    images: [
      "/assets/img/poltava_project-7.jpg",
    ],
  },
  {
    title: "Сонячна електростанція на 12 кВт",
    location: "Харківська область",
    cover: "/assets/img/harkiv_project-2.jpg",
    alt: "Сонячна електростанція на 12 кВт, Харківська область",
    galleryLabel: "Переглянути фото сонячної електростанції",
    images: [
      "/assets/img/harkiv_project-2.jpg",
    ],
  },
  {
    title: "Сонячна електростанція на 15 кВт",
    location: "м. Полтава",
    cover: "/assets/img/poltava_project-4.jpg",
    alt: "Сонячна електростанція на 15 кВт, м. Полтава",
    galleryLabel: "Переглянути фото сонячної електростанції",
    images: [
      "/assets/img/poltava_project-4.jpg",
    ],
  },
];
---

<section class="projects">
  <div class="wrapper">
    <h2 class="projects__title">
      Наші об'єкти
    </h2>

    <div class="projects__slider">
      <button
        class="projects__arrow projects__arrow--prev"
        type="button"
        aria-label="Попередній об'єкт"
      >
        &#10094;
      </button>

      <div class="projects__viewport">
        <div class="projects__track">
          {
            projects.map((project) => (
              <article class="projects__card">
                <button
                  class="projects__open-gallery"
                  type="button"
                  aria-label={project.galleryLabel}
                >
                  <img
                    src={project.cover}
                    alt={project.alt}
                    class="projects__img"
                  />

                  <span class="projects__photo-count">
                    📷 {project.images.length} фото
                  </span>
                </button>

                <div class="projects__info">
                  <h3 class="projects__name">
                    {project.title}
                  </h3>

                  <p class="projects__text">
                    {project.location}
                  </p>
                </div>

                <div class="projects__gallery" hidden>
                  {
                    project.images.map((image) => (
                      <img
                        src={image}
                        alt={project.alt}
                      />
                    ))
                  }
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <button
        class="projects__arrow projects__arrow--next"
        type="button"
        aria-label="Наступний об'єкт"
      >
        &#10095;
      </button>
    </div>
  </div>
</section>

<ProjectGallery />