---
import "../styles/style.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CallbackPopup from "../components/CallbackPopup.astro";
import PhoneButton from "../components/PhoneButton.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  robots,
} = Astro.props;
---

<!doctype html>
<html lang="uk">

  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    {robots && <meta name="robots" content={robots} />}

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/intl-tel-input@29.2.3/dist/css/intlTelInput.css"
    />

    <link
      rel="shortcut icon"
      href="/assets/img/favicon.ico"
      type="image/x-icon"
    />

    <link
      rel="canonical"
      href={canonical}
    />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/intl-tel-input@29.2.3/dist/js/intlTelInput.min.js"
    ></script>

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-3K9XKLGEQC">
    </script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-3K9XKLGEQC");
    </script>

  </head>

  <body>

    <div class="container">
      <Header />

      <slot />
    </div>

    <Footer />

    <CallbackPopup />

    <PhoneButton />

    <script>
      import "../scripts/header.js";
      import "../scripts/callbackPopup.js";
      import "../scripts/forms.js";
    </script>
  </body>

</html>